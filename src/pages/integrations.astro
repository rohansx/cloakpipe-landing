---
import Base from '../layouts/Base.astro';
import body from '../partials/integrations.html?raw';
const title = "Integrations: providers, frameworks, gateways, MCP · CloakPipe";
const description = "CloakPipe speaks the OpenAI API dialect and includes Python, LangChain, LlamaIndex, and MCP integrations, JUnit, Braintrust, and Langfuse evaluation importers, a GitHub Action, with additional framework, KMS, identity, and observability adapters on the roadmap.";
---
<Base title={title} description={description} page="integrations">
  <Fragment set:html={body} />
</Base>
