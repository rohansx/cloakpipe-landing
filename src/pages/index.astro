---
import Base from '../layouts/Base.astro';
import body from '../partials/index.html?raw';
const title = "CloakPipe · Policy enforcement for AI-agent tool calls";
const description = "A self-hosted gate between your AI agents and the tools they call. Deny-by-default argument contracts, payload-bound approvals and a hash-chained, verifiable log of every decision. Model proposes, code disposes.";
---
<Base title={title} description={description} page="index">
  <Fragment set:html={body} />
</Base>
