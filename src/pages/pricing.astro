---
import Base from '../layouts/Base.astro';
import body from '../partials/pricing.html?raw';
const title = "Pricing: free open source, Cloud in early access · CloakPipe";
const description = "CloakPipe pricing. The open-source core is free forever. Cloud Team and Business are in early access with indicative pricing, Enterprise is custom, and features not built yet are marked Planned.";
---
<Base title={title} description={description} page="pricing">
  <Fragment set:html={body} />
</Base>
