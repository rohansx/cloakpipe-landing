---
// The CloakPipe mark (public/brand/cloakpipe-logo.svg) inline, filled with
// currentColor so CSS picks the shade: --logo is #73F597 on dark and a darker
// green of the same hue on light (see styles.css / dashboard.css).
interface Props { class?: string }
const { class: cls = 'brand-mark' } = Astro.props;
---
<svg class={cls} viewBox="0 0 82 60" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M29 20 L10 20 L0 30 L0 50 L10 60 L37 60 L47 50 L47 33 L35 33 L35 45 L32 48 L15 48 L12 45 L12 35 L15 32 L29 32 Z"/>
  <path fill="currentColor" d="M53 40 L72 40 L82 30 L82 10 L72 0 L45 0 L35 10 L35 27 L47 27 L47 15 L50 12 L67 12 L70 15 L70 25 L67 28 L53 28 Z"/>
</svg>
