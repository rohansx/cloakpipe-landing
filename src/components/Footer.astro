---
// Static marketing footer, rendered at build time (was chrome.js renderFooter).
import { GH_URL } from '../lib/github';

const APP = 'https://app.cloakpipe.co';
const CONTACT = 'mailto:hello@rohan.sh';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand-row">
          <svg class="brand-mark" viewBox="0 0 22 22" fill="none">
            <path d="M2 20 L8 4 L10 4 L4 20 Z" fill="currentColor"/>
            <path d="M10 20 L16 4 L18 4 L12 20 Z" fill="currentColor"/>
            <rect x="18" y="3" width="2" height="3" fill="#00FF66"/>
            <rect x="18" y="7" width="2" height="3" fill="#00E0FF"/>
          </svg> CloakPipe
        </div>
        <p>The reliability layer for AI agents. MIT-licensed open core with a managed developer preview.</p>
      </div>
      <div class="foot-col">
        <h3>Product</h3>
        <a href="/platform">Product</a>
        <a href="/trust">Proof</a>
        <a href="/pricing">Pricing</a>
        <a href="/playground">Playground</a>
        <a href={`${APP}/demo`}>Live demo</a>
      </div>
      <div class="foot-col">
        <h3>Developers</h3>
        <a href="/docs">Documentation</a>
        <a href="/docs/quickstart">Quick start</a>
        <a href="/integrations">Integrations</a>
        <a href="/docs/mcp-gate">MCP tool gate</a>
        <a href={GH_URL}>GitHub</a>
        <a href={`${GH_URL}/releases`}>Changelog</a>
      </div>
      <div class="foot-col">
        <h3>Company</h3>
        <a href="/">Overview</a>
        <a href="/trust">Security</a>
        <a href="/platform#compliance">Compliance</a>
        <a href={CONTACT}>Contact</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 · CLOAKPIPE · MIT OPEN-SOURCE CORE</span>
      <span class="right">
        <a class="foot-gh" href={GH_URL} aria-label="CloakPipe on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>GITHUB</span>
        </a>
        <span>CLOAKPIPE.CO</span>
      </span>
    </div>
  </div>
</footer>
