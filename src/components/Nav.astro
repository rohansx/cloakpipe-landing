---
// Static marketing nav + mobile drawer, rendered at build time (was chrome.js).
// `page` is the current page slug, used to mark the active link.
// Four tabs; the logo goes home. Playground and Integrations are reached from
// Docs, the Product page and the footer.
import GitHubStar from './GitHubStar.astro';

interface Props { page?: string }
const { page = '' } = Astro.props;

// CloakPipe Cloud is in early access: the only call to action is the waitlist.
const WAITLIST = '/waitlist';

const NAV = [
  { label: 'Product', href: '/platform', slug: 'platform' },
  { label: 'Proof', href: '/trust', slug: 'trust' },
  { label: 'Docs', href: '/docs', slug: 'docs' },
  { label: 'Pricing', href: '/pricing', slug: 'pricing' },
];
---
<nav class="nav">
  <a class="brand" href="/" aria-label="CloakPipe home">
    <svg class="brand-mark" viewBox="0 0 22 22" fill="none">
      <path d="M2 20 L8 4 L10 4 L4 20 Z" fill="currentColor"/>
      <path d="M10 20 L16 4 L18 4 L12 20 Z" fill="currentColor"/>
      <rect x="18" y="3" width="2" height="3" fill="#00FF66"/>
      <rect x="18" y="7" width="2" height="3" fill="#00E0FF"/>
    </svg> CloakPipe
  </a>
  <div class="nav-links">
    {NAV.map((n, i) => (
      <>
        {i > 0 && (
          <span class="nav-tick"><svg viewBox="0 0 10 10" fill="none"><path d="M2 8 L8 2" stroke="currentColor" stroke-width="1"/></svg></span>
        )}
        <a class={n.slug === page ? 'active' : undefined} aria-current={n.slug === page ? 'page' : undefined} href={n.href}>{n.label}</a>
      </>
    ))}
  </div>
  <div class="nav-right">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14c-1 4-5 7-9 7-5 0-9-4-9-9 0-4 3-8 7-9-2 4 0 9 4 10 3 1 6 0 7-0z"/></svg>
    </button>
    <GitHubStar />
    <a class="btn btn-cta nav-desk-cta" href={WAITLIST} aria-current={page === 'waitlist' ? 'page' : undefined}><span class="corner"></span>Join the waitlist <span class="arr">→</span></a>
    <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav-scrim" id="nav-scrim"></div>
<div class="nav-drawer" id="nav-drawer">
  <div class="nav-drawer-links">
    {NAV.map((n) => (
      <a class={n.slug === page ? 'active' : undefined} aria-current={n.slug === page ? 'page' : undefined} href={n.href}>{n.label}</a>
    ))}
  </div>
  <div class="nav-drawer-cta">
    <GitHubStar variant="drawer" />
    <a class="btn btn-cta" href={WAITLIST} aria-current={page === 'waitlist' ? 'page' : undefined}><span class="corner"></span>Join the waitlist <span class="arr">→</span></a>
  </div>
</div>

<script is:inline>
  // Refresh the build-time star count. Cached for an hour; every storage
  // access is guarded (private mode, blocked storage). On any failure or a
  // rate limit the build-time value is kept, and a missing count stays hidden.
  (function () {
    var els = document.querySelectorAll('[data-gh-stars]');
    if (!els.length || !window.fetch) return;
    var KEY = 'cp-gh-stars', TTL = 3600000;
    function fmt(n) {
      if (n < 1000) return String(n);
      var k = n / 1000;
      return (k < 10 ? k.toFixed(1).replace(/\.0$/, '') : String(Math.round(k))) + 'k';
    }
    function show(n) {
      if (typeof n !== 'number' || !isFinite(n) || n < 0) return;
      els.forEach(function (el) { el.textContent = fmt(n); el.hidden = false; });
    }
    var cached = null;
    try { cached = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
    if (cached && typeof cached.n === 'number' && Date.now() - cached.t < TTL) { show(cached.n); return; }
    fetch('https://api.github.com/repos/rohansx/cloakpipe', { headers: { Accept: 'application/vnd.github+json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        var n = d && d.stargazers_count;
        if (typeof n !== 'number') return;
        show(n);
        try { localStorage.setItem(KEY, JSON.stringify({ n: n, t: Date.now() })); } catch (e) {}
      })
      .catch(function () {});
  })();
</script>
